rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shops/{shopId} {
      allow read: if true;
      allow delete: if false;

      match /settings/{docId} {
        allow read: if true;
        allow write: if true;
        allow delete: if false;
      }
      match /categories/{id} {
        allow read, write: if true;
      }
      match /menus/{id} {
        allow read, write: if true;
      }
      match /spiceLevels/{id} {
        allow read, write: if true;
      }
      match /toppings/{id} {
        allow read, write: if true;
      }
      match /orders/{id} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if false;
      }
      match /receipts/{id} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if false;
      }
    }
  }
}
