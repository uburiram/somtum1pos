rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidNewOrder() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'queue', 'items', 'total', 'status', 'paymentStatus', 'createdAt'])
        && d.paymentStatus == 'UNPAID'
        && (d.status == 'Pending' || d.status == 'AwaitingPayment')
        && d.total is number
        && d.total >= 0
        && d.total < 200000
        && d.items is list
        && d.queue is string
        && d.createdAt is number;
    }

    function coreFieldsIntact() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.queue == resource.data.queue
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total;
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /settings/{docId} {
        allow read: if true;
        // public / secure / queue / config — ร้านใช้ PIN ฝั่ง client
        allow write: if docId in ['public', 'secure', 'queue', 'config', 'fcm'];
      }

      match /categories/{id} {
        allow read, write: if true;
      }
      match /menus/{id} {
        allow read, write: if true;
      }
      match /spiceLevels/{id} {
        allow read, write: if true;
      }
      match /toppings/{id} {
        allow read, write: if true;
      }

      match /orders/{id} {
        allow read: if true;
        allow create: if isValidNewOrder();
        allow update: if coreFieldsIntact();
        allow delete: if true;
      }

      match /receipts/{id} {
        allow read, write: if true;
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if true;
      }
    }
  }
}
