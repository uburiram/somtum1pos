rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidNewOrder() {
      let d = request.resource.data;
      let payOk = d.paymentStatus == 'UNPAID'
        || (d.paymentStatus == 'PAID' && d.total == 0);
      return d.keys().hasAll(['id', 'queue', 'items', 'total', 'status', 'paymentStatus', 'createdAt'])
        && payOk
        && (d.status == 'Pending' || d.status == 'AwaitingPayment')
        && d.total is number
        && d.total >= 0
        && d.total < 200000
        && d.items is list
        && d.items.size() > 0
        && d.items.size() <= 50
        && d.queue is string
        && d.queue.size() > 0
        && d.queue.size() < 32
        && d.createdAt is number
        && d.createdAt > 0;
    }

    // อัปเดตสถานะ/ชำระ/สลิป — ห้ามแตะ id/queue/createdAt/items/total
    function coreFieldsIntact() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.queue == resource.data.queue
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total;
    }

    // โหมดโต๊ะ: เพิ่มเมนูในออเดอร์เดิม — อนุญาตดึงกลับครัว (Ready/Cooking → Pending)
    function canAppendTableItems() {
      let statusOk = request.resource.data.status == resource.data.status
        || (request.resource.data.status == 'Pending'
            && resource.data.status in ['Pending', 'Cooking', 'Ready', 'AwaitingPayment']);
      return request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.queue == resource.data.queue
        && statusOk
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && resource.data.status in ['Pending', 'Cooking', 'Ready', 'AwaitingPayment']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 80
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total < 200000;
    }

    function isTerminalOrder() {
      return resource.data.status == 'Completed' || resource.data.status == 'Cancelled';
    }

    // จำกัดเฉพาะ shop หลัก (ป้องกันสร้าง shop อื่น)
    match /shops/{shopId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /settings/{docId} {
        allow read: if true;
        // public/config/queue/fcm เขียนได้ (POS ใช้)
        // secure ยังเขียนได้เพราะไม่มี Auth — แนะนำเปิด Firebase Auth ในอนาคต
        allow write: if docId in ['public', 'secure', 'queue', 'config', 'fcm'];
      }

      match /categories/{id} {
        allow read: if true;
        allow write: if true; // POS จัดการเมนู — ควรมี Auth ในอนาคต
      }
      match /menus/{id} {
        allow read: if true;
        allow write: if true;
      }
      match /spiceLevels/{id} {
        allow read: if true;
        allow write: if true;
      }
      match /toppings/{id} {
        allow read: if true;
        allow write: if true;
      }

      match /orders/{id} {
        allow read: if true;
        allow create: if isValidNewOrder();
        allow update: if coreFieldsIntact() || canAppendTableItems();
        allow delete: if isTerminalOrder();
      }

      match /tables/{tableId} {
        allow read: if true;
        allow write: if true;
      }

      match /receipts/{id} {
        allow read: if true;
        allow write: if true;
      }

      match /fcmTokens/{tokenId} {
        allow read: if true;
        allow write: if true;
      }

      match /members/{phone} {
        allow read: if true;
        allow write: if true;
      }

      match /coupons/{id} {
        allow read: if true;
        allow write: if true;
      }

      // ลบ catch-all ที่อนุญาตทุกอย่างออกแล้ว
      // ถ้าต้องการ collection ใหม่ต้องเพิ่ม match อย่างชัดเจน
    }
  }
}
