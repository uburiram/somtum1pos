rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidNewOrder() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'queue', 'items', 'total', 'status', 'paymentStatus', 'createdAt'])
        && d.paymentStatus == 'UNPAID'
        && (d.status == 'Pending' || d.status == 'AwaitingPayment')
        && d.total is number
        && d.total >= 0
        && d.total < 200000
        && d.items is list
        && d.items.size() > 0
        && d.queue is string
        && d.createdAt is number;
    }

    function coreFieldsIntact() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.queue == resource.data.queue
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total;
    }

    // ลบได้เฉพาะออเดอร์ที่จบแล้ว (เสร็จสมบูรณ์/ยกเลิก) — กันลบคิวครัวโดยไม่ตั้งใจ
    function isTerminalOrder() {
      return resource.data.status == 'Completed' || resource.data.status == 'Cancelled';
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /settings/{docId} {
        allow read: if true;
        // secure: อนุญาตเขียน (ร้านเปลี่ยน PIN ผ่าน POS) — ยังไม่มี Auth
        // public/queue/config/fcm: เขียนได้ตามเดิม
        allow write: if docId in ['public', 'secure', 'queue', 'config', 'fcm'];
      }

      match /categories/{id} {
        allow read: if true;
        allow write: if true; // ร้านจัดการเมนูจาก POS
      }
      match /menus/{id} {
        allow read: if true;
        allow write: if true;
      }
      match /spiceLevels/{id} {
        allow read: if true;
        allow write: if true;
      }
      match /toppings/{id} {
        allow read: if true;
        allow write: if true;
      }

      match /orders/{id} {
        allow read: if true;
        allow create: if isValidNewOrder();
        // อัปเดตได้ถ้าไม่แตะ core (สถานะ/ชำระ/สลิป)
        allow update: if coreFieldsIntact();
        // ลบได้เฉพาะจบแล้ว — รีเซ็ตต้องยกเลิกก่อนแล้วค่อยลบ
        allow delete: if isTerminalOrder();
      }

      match /receipts/{id} {
        allow read, write: if true;
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if true;
      }

      // สมาชิกร้าน — ลูกค้าสมัคร/อ่านได้, ร้านจัดการแต้ม
      match /members/{phone} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if true;
      }

      // คูปองส่วนลด
      match /coupons/{code} {
        allow read: if true;
        allow write: if true;
      }
    }
  }
}
