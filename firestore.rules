rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null;
    }

    function isValidNewOrder() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'queue', 'items', 'total', 'status', 'paymentStatus', 'createdAt'])
        && d.paymentStatus == 'UNPAID'
        && (d.status == 'Pending' || d.status == 'AwaitingPayment')
        && d.total is number
        && d.total >= 0
        && d.total < 200000
        && d.items is list
        && d.queue is string
        && d.createdAt is number;
    }

    function isCustomerSlipUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['slipData', 'slipStatus'])
        && resource.data.paymentStatus == 'UNPAID'
        && request.resource.data.paymentStatus == 'UNPAID'
        && request.resource.data.status == resource.data.status
        && request.resource.data.total == resource.data.total
        && request.resource.data.items == resource.data.items
        && request.resource.data.queue == resource.data.queue
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.slipStatus in ['PENDING_REVIEW', 'NONE', 'REJECTED'];
    }

    function coreFieldsIntact() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.queue == resource.data.queue
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total;
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /settings/{docId} {
        allow read: if true;
        allow write: if docId == 'queue'
          || (isStaff() && docId in ['public', 'secure', 'config', 'fcm']);
      }

      match /categories/{id} {
        allow read: if true;
        allow write: if isStaff();
      }
      match /menus/{id} {
        allow read: if true;
        allow write: if isStaff();
      }
      match /spiceLevels/{id} {
        allow read: if true;
        allow write: if isStaff();
      }
      match /toppings/{id} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /orders/{id} {
        allow read: if true;
        allow create: if isValidNewOrder();
        allow update: if isCustomerSlipUpdate()
          || (isStaff() && coreFieldsIntact());
        allow delete: if isStaff();
      }

      match /receipts/{id} {
        allow read: if true;
        allow create, update, delete: if isStaff();
      }

      match /fcmTokens/{tokenId} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }
  }
}
