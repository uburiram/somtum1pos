rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidNewOrder() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'queue', 'items', 'total', 'status', 'paymentStatus', 'createdAt'])
        && d.paymentStatus == 'UNPAID'
        && (d.status == 'Pending' || d.status == 'AwaitingPayment')
        && d.total is number
        && d.total >= 0
        && d.total < 200000
        && d.items is list
        && d.queue is string
        && d.createdAt is number;
    }

    // ป้องกัน client ตั้ง paid เองตอน create
    function createNotPaid() {
      return request.resource.data.paymentStatus == 'UNPAID'
        && request.resource.data.get('paidAmount', 0) == 0;
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /settings/{docId} {
        allow read: if true;
        // ร้านต้องเขียนได้ (ไม่มี Auth — จำกัดเฉพาะ 3 เอกสารนี้)
        allow write: if docId in ['public', 'secure', 'config'];
      }

      match /categories/{id} {
        allow read: if true;
        allow write: if true;
      }
      match /menus/{id} {
        allow read: if true;
        allow write: if true;
      }
      match /spiceLevels/{id} {
        allow read: if true;
        allow write: if true;
      }
      match /toppings/{id} {
        allow read: if true;
        allow write: if true;
      }

      match /orders/{id} {
        allow read: if true;
        allow create: if isValidNewOrder() && createNotPaid();
        // อัปเดตสถานะ/ชำระเงินจากหน้า POS (ไม่มี Auth จึงยังเปิด write แต่ต้องมี document อยู่แล้ว)
        allow update: if request.resource.data.id == resource.data.id
                      && request.resource.data.queue == resource.data.queue
                      && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if true;
      }

      match /receipts/{id} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if true;
      }
    }
  }
}
