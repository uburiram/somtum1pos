rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ตรวจสอบโครงสร้างออเดอร์ใหม่ — ลดความเสี่ยง payload แปลก ๆ
    // หมายเหตุ: Rules ไม่ recalculate ราคาเมนูทุกชิ้น (ต้นทุน get สูง)
    // ป้องกันราคา 100% ต้องใช้ Cloud Functions (deploy แล้วเปิด FUNCTIONS_BASE)
    function isValidNewOrder() {
      let d = request.resource.data;
      let payOk = d.paymentStatus == 'UNPAID'
        || (d.paymentStatus == 'PAID' && d.total == 0);
      return d.keys().hasAll(['id', 'queue', 'items', 'total', 'status', 'paymentStatus', 'createdAt'])
        && payOk
        && (d.status == 'Pending' || d.status == 'AwaitingPayment')
        && d.total is number
        && d.total >= 0
        && d.total < 200000
        && d.items is list
        && d.items.size() > 0
        && d.items.size() <= 50
        && d.queue is string
        && d.queue.size() > 0
        && d.queue.size() < 32
        && d.createdAt is number
        && d.createdAt > 0
        && d.items[0].keys().hasAll(['name', 'qty', 'unitPrice', 'total'])
        && d.items[0].qty is number && d.items[0].qty > 0 && d.items[0].qty <= 99
        && d.items[0].unitPrice is number && d.items[0].unitPrice >= 0 && d.items[0].unitPrice < 100000
        && d.items[0].total is number && d.items[0].total >= 0 && d.items[0].total < 200000
        // ส่วนลด/แต้มที่ client ส่งมาต้องอยู่ในช่วงสมเหตุสมผล
        && (!('pointsUsed' in d) || (d.pointsUsed is number && d.pointsUsed >= 0 && d.pointsUsed <= d.total + 50000))
        && (!('couponDisc' in d) || (d.couponDisc is number && d.couponDisc >= 0 && d.couponDisc < 200000))
        && (!('discountAmount' in d) || (d.discountAmount is number && d.discountAmount >= 0 && d.discountAmount < 200000));
    }

    function coreFieldsIntact() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.queue == resource.data.queue
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total;
    }

    function canAppendTableItems() {
      let statusOk = request.resource.data.status == resource.data.status
        || (request.resource.data.status == 'Pending'
            && resource.data.status in ['Pending', 'Cooking', 'Ready', 'AwaitingPayment']);
      let payOk = request.resource.data.paymentStatus == resource.data.paymentStatus
        || (resource.data.paymentStatus == 'PAID'
            && request.resource.data.paymentStatus == 'UNPAID'
            && request.resource.data.items.size() > resource.data.items.size());
      return request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.queue == resource.data.queue
        && statusOk
        && payOk
        && resource.data.status in ['Pending', 'Cooking', 'Ready', 'AwaitingPayment']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 80
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total < 200000;
    }

    function isTerminalOrder() {
      return resource.data.status == 'Completed' || resource.data.status == 'Cancelled';
    }

    function hasImageSlip(data) {
      return data is string
        && data.size() > 40
        && data.size() <= 200000
        && data.matches('data:image/.*');
    }

    // ลูกค้าแนบสลิป: ห้ามเปลี่ยน paymentStatus / ห้าม Completed
    function canAttachSlip() {
      return coreFieldsIntact()
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.paymentStatus != 'PAID'
        && request.resource.data.status == resource.data.status
        && request.resource.data.status != 'Completed'
        && hasImageSlip(request.resource.data.slipData)
        && request.resource.data.slipStatus in ['PENDING_REVIEW', 'NONE', 'REJECTED'];
    }

    // ครัวเปลี่ยนสถานะ: ห้ามแตะการเงิน
    function canKitchenStatus() {
      return coreFieldsIntact()
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.status in ['Pending', 'AwaitingPayment', 'Cooking', 'Ready', 'Cancelled']
        && resource.data.status in ['Pending', 'AwaitingPayment', 'Cooking', 'Ready', 'Cancelled'];
    }

    // HARDEN: ตั้ง PAID จาก client ได้เฉพาะ
    // - เงินสด (ร้านกดที่เครื่อง)
    // - ยอด 0 (แต้ม/คูปองครบ)
    // - มีสลิปภาพแนบอยู่แล้ว (ร้านตรวจสลิปแล้วกดยืนยัน)
    // ห้าม mark PAID แบบโอนเปล่าโดยไม่มีสลิป (กันปลอมชำระจากเบราว์เซอร์ภายนอก)
    function canMarkPaid() {
      let d = request.resource.data;
      let zeroBill = resource.data.total is number && resource.data.total == 0;
      let hasSlip = hasImageSlip(d.slipData) || hasImageSlip(resource.data.slipData);
      return coreFieldsIntact()
        && resource.data.paymentStatus == 'UNPAID'
        && d.paymentStatus == 'PAID'
        && d.paidAt is number
        && d.paidAt > 0
        && (
          d.paymentMethod == 'CASH'
          || (zeroBill && d.paymentMethod in ['POINTS', 'COUPON', 'CASH'])
          || hasSlip
        );
    }

    // เสร็จสมบูรณ์: ต้อง PAID แล้ว
    function canComplete() {
      return coreFieldsIntact()
        && request.resource.data.status == 'Completed'
        && request.resource.data.paymentStatus == 'PAID'
        && resource.data.paymentStatus == 'PAID'
        && resource.data.status in ['Pending', 'Cooking', 'Ready', 'AwaitingPayment'];
    }

    // อัปเดตทั่วไปที่การเงินและสถานะครัวไม่เปลี่ยน
    function canSoftUpdate() {
      return coreFieldsIntact()
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.status == resource.data.status
        && !(request.resource.data.status == 'Completed' && resource.data.paymentStatus != 'PAID');
    }

    function canCancel() {
      return coreFieldsIntact()
        && request.resource.data.status == 'Cancelled'
        && resource.data.status in ['Pending', 'AwaitingPayment', 'Cooking', 'Ready']
        && request.resource.data.paymentStatus == resource.data.paymentStatus;
    }

    function canUpdateOrder() {
      return canAppendTableItems()
        || canAttachSlip()
        || canMarkPaid()
        || canComplete()
        || canKitchenStatus()
        || canCancel()
        || canSoftUpdate();
    }

    function strMax(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }
    function numRange(field, lo, hi) {
      return field is number && field >= lo && field <= hi;
    }

    function isValidCategory() {
      let d = request.resource.data;
      return strMax(d.id, 64)
        && strMax(d.name, 120)
        && (!('order' in d) || numRange(d.order, 0, 10000))
        && (!('isActive' in d) || d.isActive is bool);
    }

    function isValidMenu() {
      let d = request.resource.data;
      return strMax(d.id, 64)
        && strMax(d.name, 120)
        && (!('catId' in d) || strMax(d.catId, 64))
        && d.price is number && d.price >= 0 && d.price < 100000
        && (!('isActive' in d) || d.isActive is bool)
        && (!('isOut' in d) || d.isOut is bool)
        && (!('imageUrl' in d) || strMax(d.imageUrl, 2000))
        && (!('imageData' in d) || (d.imageData is string && d.imageData.size() <= 200000));
    }

    function isValidSpice() {
      let d = request.resource.data;
      return strMax(d.id, 64)
        && strMax(d.name, 80)
        && (!('order' in d) || numRange(d.order, 0, 10000))
        && (!('isActive' in d) || d.isActive is bool);
    }

    function isValidTopping() {
      let d = request.resource.data;
      return strMax(d.id, 64)
        && strMax(d.name, 80)
        && d.price is number && d.price >= 0 && d.price < 100000
        && (!('isActive' in d) || d.isActive is bool)
        && (!('order' in d) || numRange(d.order, 0, 10000));
    }

    // HARDEN สมาชิก:
    // - สมัครใหม่: points ต้องเป็น 10 เท่านั้น (แต้มต้อนรับ)
    // - อัปเดต: แต้มลดได้ไม่จำกัด (ใช้แต้ม) แต่เพิ่มได้ไม่เกิน +5000 ต่อครั้ง (ร้านแจกแต้ม/award ได้) (กันปั๊มแต้ม)
    // - award หลังชำระปกติได้สูงสุด ~ยอด/100 ต่อออเดอร์ — เพดาน +5000 ครอบคลุมแจกแต้มร้าน + award ปกติ
    function isValidMemberCreate(phone) {
      let d = request.resource.data;
      return strMax(phone, 16)
        && (!('phone' in d) || strMax(d.phone, 16))
        && (!('firstName' in d) || strMax(d.firstName, 80))
        && (!('lastName' in d) || strMax(d.lastName, 80))
        && d.points is number
        && d.points == 10
        && (!('totalSpent' in d) || numRange(d.totalSpent, 0, 0))
        && (!('orderCount' in d) || numRange(d.orderCount, 0, 0));
    }

    function isValidMemberUpdate(phone) {
      let d = request.resource.data;
      let prev = resource.data;
      let newPts = ('points' in d) ? d.points : prev.points;
      let oldPts = ('points' in prev) ? prev.points : 0;
      return strMax(phone, 16)
        && (!('phone' in d) || strMax(d.phone, 16))
        && (!('firstName' in d) || strMax(d.firstName, 80))
        && (!('lastName' in d) || strMax(d.lastName, 80))
        && newPts is number
        && newPts >= 0
        && newPts <= 10000000
        && newPts <= oldPts + 5000
        && (!('totalSpent' in d) || numRange(d.totalSpent, 0, 100000000))
        && (!('orderCount' in d) || numRange(d.orderCount, 0, 1000000));
    }

    function isValidCoupon(cid) {
      let d = request.resource.data;
      return strMax(cid, 64)
        && (!('code' in d) || strMax(d.code, 64))
        && (!('type' in d) || d.type in ['fixed', 'percent'])
        && (!('value' in d) || numRange(d.value, 0, 100000))
        && (!('minSpend' in d) || numRange(d.minSpend, 0, 1000000))
        && (!('usedCount' in d) || numRange(d.usedCount, 0, 1000000))
        && (!('active' in d) || d.active is bool)
        && (!('isActive' in d) || d.isActive is bool);
    }

    function isValidTable() {
      let d = request.resource.data;
      return (!('tableNo' in d) || numRange(d.tableNo, 1, 500))
        && (!('status' in d) || d.status in ['free', 'occupied', ''])
        && (!('activeOrderId' in d) || d.activeOrderId == null || strMax(d.activeOrderId, 128))
        && (!('callStaff' in d) || d.callStaff is bool);
    }

    function isValidSettingsDoc() {
      let d = request.resource.data;
      return (!('shopName' in d) || strMax(d.shopName, 120))
        && (!('promptpay' in d) || strMax(d.promptpay, 32))
        && (!('accountName' in d) || strMax(d.accountName, 120))
        && (!('kshopPayload' in d) || strMax(d.kshopPayload, 2000))
        && (!('queueCounter' in d) || numRange(d.queueCounter, 0, 100000))
        && (!('tableCount' in d) || numRange(d.tableCount, 0, 500))
        && (!('orderMode' in d) || d.orderMode in ['queue', 'table', 'auto']);
    }

    function isValidSecureSettings() {
      let d = request.resource.data;
      return isValidSettingsDoc()
        && (!('pinHash' in d) || strMax(d.pinHash, 128))
        && (!('mustChangePin' in d) || d.mustChangePin is bool);
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /settings/{docId} {
        // public docs อ่านได้ — secure อ่านได้เพื่อตรวจ PIN ฝั่ง client (ยังไม่มี Auth)
        // ระยะยาว: ย้ายตรวจ PIN ไป Cloud Function แล้วปิด read secure
        allow read: if true;
        allow write: if docId in ['public', 'queue', 'config', 'fcm']
          && isValidSettingsDoc()
          && !('pinHash' in request.resource.data);
        allow write: if docId == 'secure'
          && isValidSecureSettings();
      }

      match /categories/{id} {
        allow read: if true;
        allow create, update: if isValidCategory();
        allow delete: if false;
      }
      match /menus/{id} {
        allow read: if true;
        allow create, update: if isValidMenu();
        allow delete: if false;
      }
      match /spiceLevels/{id} {
        allow read: if true;
        allow create, update: if isValidSpice();
        allow delete: if false;
      }
      match /toppings/{id} {
        allow read: if true;
        allow create, update: if isValidTopping();
        allow delete: if false;
      }

      match /orders/{id} {
        allow read: if true;
        allow create: if isValidNewOrder();
        allow update: if canUpdateOrder();
        allow delete: if isTerminalOrder();
      }

      match /tables/{tableId} {
        allow read: if true;
        allow create, update: if isValidTable();
        allow delete: if false;
      }

      match /receipts/{id} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().size() <= 40;
        // HARDEN: ห้ามลบใบเสร็จจาก client ภายนอก
        allow delete: if false;
      }

      match /fcmTokens/{tokenId} {
        allow read: if true;
        allow write: if strMax(tokenId, 512)
          && request.resource.data.keys().size() <= 20;
      }

      match /members/{phone} {
        allow read: if true;
        allow create: if isValidMemberCreate(phone);
        allow update: if isValidMemberUpdate(phone);
        allow delete: if false;
      }

      match /coupons/{id} {
        allow read: if true;
        allow create, update: if isValidCoupon(id);
        allow delete: if false;
      }
    }
  }
}
